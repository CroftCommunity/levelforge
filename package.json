{
  "name": "levelforge",
  "version": "1.0.0",
  "description": "Touch-first, phone-friendly 2D physics level editor and test bed for human-and-Claude collaboration.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"test/**/*.ts\""
  },
  "dependencies": {
    "matter-js": "0.19.0"
  },
  "devDependencies": {
    "@types/matter-js": "0.19.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
